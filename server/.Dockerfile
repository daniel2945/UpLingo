# משתמשים באימג' הקל של Node
FROM node:22-alpine
# מגדירים לאן הקוד ייכנס בתוך הקונטיינר
WORKDIR /app

# מעתיקים את רשימת הספריות ומתקינים אותן
COPY package*.json ./
RUN npm install

# מעתיקים את שאר הקוד של השרת
COPY . .

# מציינים שהשרת עובד על פורט 5000
EXPOSE 5000

# מפעילים את השרת במצב פיתוח
CMD ["npm", "run", "dev"]